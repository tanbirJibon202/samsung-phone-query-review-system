# PostgreSQL connection string (Neon, or any Postgres with the pgvector
# extension available). Note the psycopg (v3) driver scheme, required by
# langchain-postgres.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/samsung_phones?sslmode=require

# Free Groq API key (console.groq.com) - powers ChatGroq and the LangChain agents.
GROQ_API_KEY=

# Groq model id. llama-3.3-70b-versatile is Enterprise-tier only as of mid-2026;
# openai/gpt-oss-120b is Groq's recommended free/developer-tier alternative.
# Switch this back to llama-3.3-70b-versatile if you have paid Groq access.
GROQ_MODEL=openai/gpt-oss-120b
